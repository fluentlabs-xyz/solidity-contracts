# Config for drand-publisher, read once at startup. Install as
# /etc/drand-publisher.env with mode 0600 — the first line is a signing key.

# The account that pays for publishing. One publisher per key: two processes on
# one key collide on nonces.
DRAND_SIGNING_KEY=0x

DRAND_RPC_URL=https://rpc.testnet.fluent.xyz
DRAND_ORACLE_ADDRESS=0xFaf73E6bc241f133498D453146cbcc27415eB907

# Walked top to bottom; a body that fails verification demotes its relay and the
# same round is asked of the next one. All four are checked against quicknet.
DRAND_RELAYS=https://api.drand.sh,https://api2.drand.sh,https://api3.drand.sh,https://drand.cloudflare.com

DRAND_POLL_INTERVAL_SECONDS=3
DRAND_PENDING_TIMEOUT_SECONDS=30
